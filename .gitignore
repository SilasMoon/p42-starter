# ---------------------------------------------------------------------------
# Project 42 — what is NOT under configuration control, and why.
#
# The rule: version everything that CANNOT be regenerated, exclude everything
# that can. The working tree is ~17 GB; what matters is ~90 MB.
# ---------------------------------------------------------------------------

# --- Python environments (regenerable from requirements) -------------------
ingest-venv/
sparse-venv/
render-venv/
__pycache__/
*.pyc
*.pyo

# --- Model weights and caches (multi-GB, downloaded from Hugging Face) ------
hf-cache/

# --- The live vector database (rebuildable by re-running ingestion) --------
# This is DERIVED data. The inputs (corpus + ingest_v3.py + its config) are
# versioned, so any collection here can be rebuilt exactly.
qdrant_storage/

# --- THE CORPUS ITSELF -----------------------------------------------------
# 145 ECSS PDFs, ~161 MB. Deliberately NOT versioned, for two reasons:
#   1. size;
#   2. these are third-party standards documents. They are freely available
#      from ecss.nl, but "freely available" is not the same as "licensed for
#      redistribution", and a git repository redistributes.
# corpus/CORPUS_MANIFEST.tsv carries the filename and SHA-256 of all 145 so
# anyone can verify they hold the identical corpus.
corpus/pdf/
*.pdf

# --- Bulk source material and archives --------------------------------------
ecss_active_handbooks_2026-08-18/
Active ECSS Standards_PDF-files*/
kb-docs/
*.zip

# --- Scratch ---------------------------------------------------------------
scratchpad/
*.tmp
*.log
nohup.out

# --- Extracted full text of the standards ----------------------------------
# Same reasoning as corpus/pdf/: this is the third-party document content,
# just in another format. Regenerated by the ingestion parse.
corpus/txt/
corpus/quarantine/
*.tgz

# --- Superseded / backup files ---------------------------------------------
*.bak
